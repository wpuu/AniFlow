{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "GroupId": {
      "Type": "String",
      "AllowedPattern": "sg-[a-zA-Z0-9]+"
    },
    "DeadlineUtc": {
      "Type": "String",
      "AllowedPattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
    }
  },
  "Resources": {
    "GuardRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeleteExactTokyoGroupOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "gameliftstreams:GetStreamGroup",
                    "gameliftstreams:DeleteStreamGroup"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:gameliftstreams:ap-northeast-1:${AWS::AccountId}:streamgroup/${GroupId}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Guard": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.13",
        "Handler": "index.handler",
        "Timeout": 45,
        "Role": {
          "Fn::GetAtt": [
            "GuardRole",
            "Arn"
          ]
        },
        "Environment": {
          "Variables": {
            "GROUP_ID": {
              "Ref": "GroupId"
            },
            "DEADLINE_UTC": {
              "Ref": "DeadlineUtc"
            }
          }
        },
        "Code": {
          "ZipFile": "\"\"\"Fixed-deadline, exact-resource GameLift guard. Never allocates capacity.\"\"\"\nimport os\nfrom datetime import UTC, datetime\n\nimport boto3\nfrom botocore.exceptions import ClientError\n\n\ndef handler(event, context):\n    deadline = datetime.fromisoformat(os.environ[\"DEADLINE_UTC\"])\n    if datetime.now(UTC) < deadline:\n        return {\"state\": \"armed\", \"deadline_utc\": deadline.isoformat()}\n    group = os.environ[\"GROUP_ID\"]\n    client = boto3.client(\"gameliftstreams\", region_name=\"ap-northeast-1\")\n    try:\n        current = client.get_stream_group(Identifier=group)\n        if current[\"Status\"] != \"DELETING\":\n            client.delete_stream_group(Identifier=group)\n        # A successful delete response does not prove capacity release.\n        current = client.get_stream_group(Identifier=group)\n        return {\"state\": \"deletion_pending\", \"status\": current[\"Status\"]}\n    except ClientError as exc:\n        if exc.response[\"Error\"][\"Code\"] == \"ResourceNotFoundException\":\n            return {\"state\": \"released\", \"group_id\": group}\n        raise\n"
        }
      }
    },
    "Tick": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "ScheduleExpression": "rate(1 minute)",
        "State": "ENABLED",
        "Targets": [
          {
            "Id": "FixedDeadline",
            "Arn": {
              "Fn::GetAtt": [
                "Guard",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumEventAgeInSeconds": 300,
              "MaximumRetryAttempts": 3
            }
          }
        ]
      }
    },
    "Invoke": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Guard"
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "Tick",
            "Arn"
          ]
        }
      }
    }
  },
  "Outputs": {
    "Function": {
      "Value": {
        "Ref": "Guard"
      }
    },
    "Rule": {
      "Value": {
        "Ref": "Tick"
      }
    }
  }
}
