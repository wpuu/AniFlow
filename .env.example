# Agnes
AGNES_API_ROOT=https://apihub.agnes-ai.com
# 多账户 API Key，用英文逗号分隔。真实 Key 只放本地 .env / GitHub Actions Secrets / 服务端 Secret Store。
AGNES_API_KEYS=key_account_1,key_account_2,key_account_3
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# Pipeline
ANIFLOW_ASPECT_RATIO=9:16
ANIFLOW_IMAGE_SIZE=1K
ANIFLOW_VIDEO_SECONDS=5
ANIFLOW_CANDIDATES_PER_SEGMENT=5
ANIFLOW_MAX_REPAIR_ROUNDS=2
ANIFLOW_PASS_SCORE=82

# S3-compatible public media storage (Cloudflare R2 recommended)
# Only temporary keyframes / sampled frames / generated media need public URLs for Agnes.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_REGION=auto
