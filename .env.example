# Agnes
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# 多账户 API Key，用英文逗号分隔。只放在本地 .env 或 GitHub Actions Secrets，禁止提交真实 Key。
AGNES_API_KEYS=key_account_1,key_account_2,key_account_3
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# Pipeline
ANIFLOW_ASPECT_RATIO=9:16
ANIFLOW_IMAGE_SIZE=1K
ANIFLOW_VIDEO_SECONDS=5
ANIFLOW_CANDIDATES_PER_SEGMENT=5
ANIFLOW_MAX_REPAIR_ROUNDS=2
ANIFLOW_PASS_SCORE=82

# Public media host for Agnes vision/keyframe URLs.
# V0.1 accepts already-public URLs; R2 uploader will plug into this layer.
ANIFLOW_PUBLIC_MEDIA_BASE_URL=
